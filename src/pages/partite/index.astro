---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Chess } from 'chess.js';
import { classifyPgn } from '../../lib/openings';
import { SITE_URL, breadcrumbJsonLd } from '../../data/club';

const raw = await getCollection('partite', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
);

// Epoca storica in base all'anno (per i filtri).
const ERAS = ['Romantica', 'Classica', 'Era sovietica', 'Contemporanea'] as const;
function eraOf(year: number): string {
  if (year < 1900) return 'Romantica';
  if (year < 1946) return 'Classica';
  if (year < 1990) return 'Era sovietica';
  return 'Contemporanea';
}

// Arricchisce ogni partita con apertura (calcolata), epoca e posizione finale (FEN).
const games = raw
  .map((entry) => {
    const d = entry.data;
    const opening = classifyPgn(d.pgn);
    const chess = new Chess();
    chess.loadPgn(d.pgn);
    const players = `${d.white} – ${d.black}`;
    return {
      slug: entry.id,
      title: d.nickname || players,
      // Se il titolo e' gia' il nickname, sotto mostriamo i giocatori;
      // altrimenti evitiamo di ripeterli.
      showPlayers: Boolean(d.nickname),
      players,
      white: d.white,
      black: d.black,
      year: d.year,
      place: d.place ?? '',
      result: d.result,
      fen: chess.fen(),
      eco: opening?.eco ?? '',
      family: opening?.family ?? 'Altro',
      era: eraOf(d.year),
      moves: chess.history().length,
    };
  })
  .sort((a, b) => a.year - b.year || a.title.localeCompare(b.title, 'it'));

// Elenco famiglie presenti, per i filtri.
const families = Array.from(new Set(games.map((g) => g.family))).sort((a, b) =>
  a.localeCompare(b, 'it')
);
// Epoche presenti, nell'ordine cronologico definito.
const eras = ERAS.filter((e) => games.some((g) => g.era === e));

// Elenco scacchisti presenti (bianco o nero), con conteggio partite.
// Escludiamo i "non giocatori" (Il Mondo, computer) dai filtri nominali.
const EXCLUDE_PLAYERS = new Set(['Il Mondo', 'Deep Blue']);
const playerCount = new Map<string, number>();
for (const g of games) {
  for (const name of [g.white, g.black]) {
    if (EXCLUDE_PLAYERS.has(name)) continue;
    playerCount.set(name, (playerCount.get(name) ?? 0) + 1);
  }
}
// Conteggi per le voci dei menu (es. "Difesa Siciliana (3)").
const countBy = (key: 'family' | 'era') => {
  const m = new Map<string, number>();
  for (const g of games) m.set(g[key], (m.get(g[key]) ?? 0) + 1);
  return m;
};
const familyCount = countBy('family');
const eraCount = countBy('era');

// Ordina per cognome (ultima parola del nome), poi per nome completo.
const surname = (n: string) => n.trim().split(/\s+/).slice(-1)[0];
const players = Array.from(playerCount.keys()).sort((a, b) =>
  surname(a).localeCompare(surname(b), 'it') || a.localeCompare(b, 'it')
);

const metaDescription =
  'Archivio di partite di scacchi celebri commentate, con scacchiera interattiva: ' +
  'scorri le mosse avanti e indietro. A cura del Circolo Scacchi Santa Sabina.';

const crumbs = breadcrumbJsonLd([
  { name: 'Home', path: '/' },
  { name: 'Partite', path: '/partite' },
]);

// Mini-scacchiera FEN -> griglia di codici pezzo (es. "wP", "bK") o '' per casa vuota.
// Usa gli stessi SVG merida del visualizzatore di dettaglio.
const PIECE_SET = 'merida';
function fenToPieces(fen: string): (string | null)[][] {
  const board = fen.split(' ')[0];
  return board.split('/').map((row) => {
    const cells: (string | null)[] = [];
    for (const ch of row) {
      if (/\d/.test(ch)) {
        for (let i = 0; i < +ch; i++) cells.push(null);
      } else {
        const color = ch === ch.toUpperCase() ? 'w' : 'b';
        cells.push(color + ch.toUpperCase());
      }
    }
    return cells;
  });
}
---

<BaseLayout title="Partite — Archivio didattico" description={metaDescription} jsonLd={[crumbs]}>
  <section class="section">
    <div class="container">
      <header class="arch-head">
        <h1>Partite celebri</h1>
        <p class="arch-sub">
          Un archivio didattico: scegli una partita e scorri le mosse sulla scacchiera,
          avanti e indietro, con i commenti.
        </p>
      </header>

      {games.length === 0 ? (
        <p class="arch-empty">Nessuna partita in archivio al momento.</p>
      ) : (
        <>
          <div class="arch-filters" data-filters>
            <div class="arch-bar">
              <input
                type="search"
                class="arch-field arch-search"
                data-search
                placeholder="Cerca giocatore, anno, luogo…"
                aria-label="Cerca partita"
              />

              <label class="arch-select">
                <span class="arch-select-label">Epoca</span>
                <select class="arch-field" data-filter="era" aria-label="Filtra per epoca">
                  <option value="">Tutte le epoche</option>
                  {eras.map((e) => (
                    <option value={e}>{e} ({eraCount.get(e)})</option>
                  ))}
                </select>
              </label>

              <label class="arch-select">
                <span class="arch-select-label">Apertura</span>
                <select class="arch-field" data-filter="family" aria-label="Filtra per apertura">
                  <option value="">Tutte le aperture</option>
                  {families.map((f) => (
                    <option value={f}>{f} ({familyCount.get(f)})</option>
                  ))}
                </select>
              </label>

              <label class="arch-select">
                <span class="arch-select-label">Scacchista</span>
                <select class="arch-field" data-filter="player" aria-label="Filtra per scacchista">
                  <option value="">Tutti gli scacchisti</option>
                  {players.map((p) => (
                    <option value={p}>{p} ({playerCount.get(p)})</option>
                  ))}
                </select>
              </label>
            </div>

            <div class="arch-status">
              <span data-count>{games.length} partite</span>
              <button type="button" class="arch-reset" data-reset hidden>Azzera filtri</button>
            </div>
          </div>

          <ul class="arch-grid" data-grid>
            {games.map((g) => (
              <li
                class="arch-card"
                data-card
                data-family={g.family}
                data-era={g.era}
                data-players={`|${g.white}|${g.black}|`}
                data-search-text={`${g.white} ${g.black} ${g.place} ${g.year} ${g.eco} ${g.family} ${g.era}`.toLowerCase()}
              >
                <a href={`/partite/${g.slug}`} class="arch-link">
                  <div class="arch-mini" aria-hidden="true">
                    {fenToPieces(g.fen).map((row, r) => (
                      row.map((pc, c) => (
                        <span class:list={['mini-sq', (r + c) % 2 === 0 ? 'mini-l' : 'mini-d']}>
                          {pc && <img src={`/pieces/${PIECE_SET}/${pc}.svg`} alt="" loading="lazy" draggable="false" />}
                        </span>
                      ))
                    ))}
                  </div>
                  <div class="arch-info">
                    <h2 class="arch-title">{g.title}</h2>
                    {g.showPlayers && <p class="arch-players">{g.players}</p>}
                    <p class="arch-sub2">
                      {[g.place, g.year].filter(Boolean).join(', ')}
                      <span class="arch-result">{g.result}</span>
                    </p>
                    <p class="arch-open">
                      {g.eco && <span class="arch-eco">{g.eco}</span>}
                      <span>{g.family}</span>
                    </p>
                  </div>
                </a>
              </li>
            ))}
          </ul>

          <p class="arch-noresult" data-noresult hidden>Nessuna partita corrisponde ai filtri.</p>
        </>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .arch-head { text-align: center; margin-bottom: 2rem; }
  .arch-sub { color: var(--text-secondary); max-width: 560px; margin: 0.5rem auto 0; }
  .arch-empty { text-align: center; color: var(--text-muted); padding: 3rem 0; }

  /* Barra filtri compatta: una riga, scala con qualsiasi numero di voci */
  .arch-filters { margin-bottom: 2rem; }
  .arch-bar {
    display: grid;
    grid-template-columns: minmax(200px, 1.4fr) repeat(3, minmax(150px, 1fr));
    gap: 0.75rem;
    align-items: end;
  }
  .arch-select { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .arch-select-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .arch-field {
    width: 100%;
    height: 42px;
    padding: 0 0.9rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-primary);
    font: inherit;
    font-size: 0.9rem;
    transition: border-color 0.2s;
  }
  .arch-field:focus { outline: none; border-color: var(--accent); }
  select.arch-field {
    appearance: none;
    cursor: pointer;
    padding-right: 2.2rem;
    text-overflow: ellipsis;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--text-muted) 50%),
      linear-gradient(135deg, var(--text-muted) 50%, transparent 50%);
    background-position: calc(100% - 18px) 50%, calc(100% - 13px) 50%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
  }
  /* menu con un filtro attivo: evidenziato */
  select.arch-field.is-active { border-color: var(--accent); color: var(--accent); }
  select.arch-field option { background: var(--bg-card); color: var(--text-primary); }

  .arch-status {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.8rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .arch-reset {
    background: none;
    border: none;
    padding: 0;
    color: var(--accent);
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .arch-reset:hover { color: var(--accent-hover); }

  @media (max-width: 860px) {
    .arch-bar { grid-template-columns: 1fr 1fr; }
    .arch-search { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .arch-bar { grid-template-columns: 1fr; gap: 0.5rem; }
    /* le voci "Tutte le epoche" ecc. sono autoesplicative: niente etichette */
    .arch-select-label {
      position: absolute; width: 1px; height: 1px;
      overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
    }
  }

  .arch-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .arch-card { margin: 0; }
  .arch-link {
    display: block;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    height: 100%;
    color: inherit;
  }
  .arch-link:hover {
    transform: translateY(-4px);
    border-color: rgba(212,160,84,0.3);
    box-shadow: 0 14px 36px rgba(0,0,0,0.3);
  }

  .arch-mini {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: repeat(8, 1fr);
    aspect-ratio: 1 / 1;
    width: 100%;
    border-bottom: 1px solid var(--border);
  }
  .mini-sq {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  /* Stesso legno del visualizzatore di dettaglio */
  .mini-l {
    background:
      linear-gradient(135deg, rgba(255,255,255,0.05), rgba(0,0,0,0.04)),
      linear-gradient(135deg, #ecc98f, #d9ac6e);
  }
  .mini-d {
    background:
      linear-gradient(135deg, rgba(255,255,255,0.05), rgba(0,0,0,0.06)),
      linear-gradient(135deg, #9c5c40, #7a4530);
  }
  .mini-sq img {
    width: 86%;
    height: 86%;
    object-fit: contain;
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.4));
  }

  .arch-info { padding: 1rem 1.1rem 1.2rem; }
  .arch-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    margin: 0 0 0.2rem;
    color: var(--text-primary);
  }
  .arch-players { font-size: 0.9rem; color: var(--text-secondary); margin: 0; }
  .arch-sub2 { font-size: 0.85rem; color: var(--text-muted); margin: 0.3rem 0 0; }
  .arch-result {
    margin-left: 0.4rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
  }
  .arch-open {
    margin: 0.6rem 0 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
  .arch-eco {
    background: rgba(212,160,84,0.15);
    color: var(--accent);
    font-weight: 700;
    padding: 0.05rem 0.4rem;
    border-radius: 4px;
  }

  .arch-noresult { text-align: center; color: var(--text-muted); padding: 2rem 0; }
</style>

<script>
  // Nome del parametro URL per ciascun filtro (link condivisibili).
  const URL_KEYS = { era: 'epoca', family: 'apertura', player: 'scacchista', q: 'q' } as const;
  type FilterKey = 'era' | 'family' | 'player';

  function initArchive() {
    const search = document.querySelector<HTMLInputElement>('[data-search]');
    const selects = Array.from(
      document.querySelectorAll<HTMLSelectElement>('select[data-filter]')
    );
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
    const noResult = document.querySelector<HTMLElement>('[data-noresult]');
    const countEl = document.querySelector<HTMLElement>('[data-count]');
    const resetBtn = document.querySelector<HTMLButtonElement>('[data-reset]');
    if (!cards.length) return;

    const selectOf = (k: FilterKey) =>
      selects.find((s) => s.dataset.filter === k) ?? null;

    // Ripristina lo stato dai parametri URL (se validi).
    const params = new URLSearchParams(location.search);
    for (const s of selects) {
      const k = s.dataset.filter as FilterKey;
      const v = params.get(URL_KEYS[k]);
      if (v && Array.from(s.options).some((o) => o.value === v)) s.value = v;
    }
    if (search) search.value = params.get(URL_KEYS.q) ?? '';

    function syncUrl() {
      const p = new URLSearchParams();
      for (const s of selects) {
        if (s.value) p.set(URL_KEYS[s.dataset.filter as FilterKey], s.value);
      }
      const q = search?.value.trim();
      if (q) p.set(URL_KEYS.q, q);
      const qs = p.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }

    function apply() {
      const fam = selectOf('family')?.value ?? '';
      const era = selectOf('era')?.value ?? '';
      const player = selectOf('player')?.value ?? '';
      const query = (search?.value ?? '').trim().toLowerCase();

      let visible = 0;
      for (const card of cards) {
        const show =
          (!fam || card.dataset.family === fam) &&
          (!era || card.dataset.era === era) &&
          (!player || (card.dataset.players ?? '').includes(`|${player}|`)) &&
          (!query || (card.dataset.searchText ?? '').includes(query));
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      }

      for (const s of selects) s.classList.toggle('is-active', Boolean(s.value));
      const anyActive = selects.some((s) => s.value) || Boolean(query);
      if (resetBtn) resetBtn.hidden = !anyActive;
      if (countEl) {
        countEl.textContent = anyActive
          ? `${visible} di ${cards.length} partite`
          : `${cards.length} partite`;
      }
      if (noResult) noResult.hidden = visible > 0;
      syncUrl();
    }

    selects.forEach((s) => s.addEventListener('change', apply));
    search?.addEventListener('input', apply);
    resetBtn?.addEventListener('click', () => {
      selects.forEach((s) => (s.value = ''));
      if (search) search.value = '';
      apply();
    });

    apply();
  }

  if (document.readyState !== 'loading') initArchive();
  else document.addEventListener('DOMContentLoaded', initArchive);
</script>
