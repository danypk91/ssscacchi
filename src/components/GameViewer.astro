    overflow: hidden;
    pointer-events: none;
  }
  /* etichetta all'estremita' di chi e' in vantaggio */
  .gv-evalbar-label.at-bottom { bottom: 4px; }
  .gv-evalbar-label.at-top { top: 4px; }
