  @media (max-width: 860px) {
    .gv {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1rem;
    }
    .gv-side { min-height: 0; }
    /* su mobile la lista non deve essere alta come la scacchiera */
    .gv-moves {
