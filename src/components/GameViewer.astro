---
// Visualizzatore di partita didattico: scacchiera PIATTA (senza inclinazione),
// con coordinate, comandi avanti/indietro/play, lista mosse cliccabile,
// evidenziazione ultima mossa, commenti per mossa, flip scacchiera.
//
// I pezzi scivolano anche navigando all'indietro o saltando a una mossa lontana,
// grazie a id stabili tracciati lungo tutta la partita.

interface Comment { ply: number; text: string }

interface Props {
  pgn: string;
  comments?: Comment[];
  set?: 'merida' | 'cburnett' | 'chessnut';
  orientation?: 'white' | 'black';
}
const { pgn, comments = [], set = 'merida', orientation = 'white' } = Astro.props;

const commentsJson = JSON.stringify(comments);

// --- Valutazioni del motore (precalcolate da scripts/eval-partite.mjs) ---
// Si passano alla pagina solo quelle delle posizioni di QUESTA partita.
import { Chess } from 'chess.js';
import evalsData from '../data/evals.json';
type Ev = { c?: number; m?: number; w?: 'w' | 'b' };
const table = (evalsData as { depth: number; engine: string; positions: Record<string, Ev> }).positions;
const posKey = (fen: string) => fen.split(' ').slice(0, 4).join(' ');
const plyEvals: (Ev | null)[] = [];
{
  const src = new Chess();
  src.loadPgn(pgn);
  const r = new Chess();
  plyEvals.push(table[posKey(r.fen())] ?? null);
  for (const mv of src.history()) {
    r.move(mv);
    plyEvals.push(table[posKey(r.fen())] ?? null);
  }
}
const missing = plyEvals.filter((e) => !e).length;
// La barra compare solo se la partita e' valutata per intero.
const hasEvals = missing === 0;
if (!hasEvals) {
  console.warn(
    `[GameViewer] ${missing}/${plyEvals.length} posizioni senza valutazione: ` +
      `lancia 'node scripts/eval-partite.mjs'. Barra e grafico nascosti.`
  );
}
const evalsJson = hasEvals ? JSON.stringify(plyEvals) : '';
const engineInfo = `${(evalsData as any).engine}, profondità ${(evalsData as any).depth}`;
---

<div
  class="gv"
  data-game-viewer
  data-pgn={pgn}
  data-comments={commentsJson}
  data-set={set}
  data-orientation={orientation}
  data-evals={evalsJson}
>
  <div class="gv-main">
   <div class="gv-board-row">
    {hasEvals && (
      <div class="gv-evalbar" data-evalbar role="img" aria-label="Valutazione della posizione" title={`Valutazione: ${engineInfo}`}>
        <div class="gv-evalbar-fill" data-evalbar-fill></div>
        <div class="gv-evalbar-mid" aria-hidden="true"></div>
        <span class="gv-evalbar-label" data-evalbar-label></span>
      </div>
    )}
    <div class="gv-board-wrap">
      <div class="gv-board" data-board>
        {Array.from({ length: 64 }).map((_, i) => {
          const row = Math.floor(i / 8);
          const col = i % 8;
          const isLight = (row + col) % 2 === 0;
          return <div class:list={['gv-sq', isLight ? 'gv-sq-l' : 'gv-sq-d']} data-sq-index={i}></div>;
        })}
        <div class="gv-pieces" data-pieces></div>
        <div class="gv-coords gv-files" data-files aria-hidden="true"></div>
        <div class="gv-coords gv-ranks" data-ranks aria-hidden="true"></div>
      </div>
    </div>
   </div>

    <div class="gv-controls" role="group" aria-label="Controlli partita">
      <button class="gv-btn" data-first aria-label="Prima mossa" title="Inizio (Home)">&#x23EE;</button>
      <button class="gv-btn" data-prev aria-label="Mossa precedente" title="Indietro (←)">&#x25C0;</button>
      <button class="gv-btn gv-btn-play" data-play aria-label="Play/Pausa" title="Play/Pausa (spazio)">&#x25B6;</button>
      <button class="gv-btn" data-next aria-label="Mossa successiva" title="Avanti (→)">&#x25B6;&#x25B6;</button>
      <button class="gv-btn" data-last aria-label="Ultima mossa" title="Fine (End)">&#x23ED;</button>
      <button class="gv-btn gv-btn-flip" data-flip aria-label="Gira scacchiera" title="Gira scacchiera (F)">&#x21C5;</button>
    </div>
  </div>

  <div class="gv-side">
    <ol class="gv-moves" data-moves aria-label="Elenco mosse"></ol>
    {hasEvals && (
      <figure class="gv-chart" data-chart>
        <!-- valore completo, come il pannello di analisi di lichess -->
        <div class="gv-evalread" aria-live="polite">
          <span class="gv-evalread-num" data-evalread-num></span>
          <span class="gv-evalread-txt" data-evalread-txt></span>
        </div>
        <svg viewBox="0 0 100 40" preserveAspectRatio="none" aria-label="Andamento del vantaggio: tocca per andare a quella mossa" role="img">
          <rect x="0" y="0" width="100" height="40" class="gv-chart-bg" />
          <path class="gv-chart-area" data-chart-area d="" />
          <line x1="0" y1="20" x2="100" y2="20" class="gv-chart-mid" />
          <line x1="0" y1="0" x2="0" y2="40" class="gv-chart-cursor" data-chart-cursor />
        </svg>
        <figcaption>Vantaggio · {engineInfo}</figcaption>
      </figure>
    )}
    <div class="gv-comment" data-comment hidden></div>
  </div>
</div>

<style>
  .gv {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 1.5rem;
    align-items: start;
  }
  .gv-main { min-width: 0; display: flex; flex-direction: column; }

