  }
  .gv-moves :global(.gv-move.has-comment)::after { content: ' \25C6'; color: var(--accent); font-size: 0.6em; vertical-align: super; }
  .gv-moves :global(.gv-move.current.has-comment)::after { color: #2a1a0e; }

  .gv-comment {
    margin-top: 0.8rem;
    padding: 0.8rem 1rem;
